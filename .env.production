# ────────────────────────────────────────────────────────────────────────────
# Root .env.production — Template for production deployment
# Copy this to .env and fill in real values before deploying
# ────────────────────────────────────────────────────────────────────────────

# ── Backend ───────────────────────────────────────────────────────────────────
DATABASE_URL=sqlite+aiosqlite:///./textile_waste.db
SECRET_KEY=REPLACE_WITH_SECURE_64_CHAR_RANDOM_KEY
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
BACKEND_CORS_ORIGINS=["https://your-app.com"]
ENVIRONMENT=production
LOG_LEVEL=INFO
MAX_UPLOAD_SIZE_MB=10

# ── Frontend ──────────────────────────────────────────────────────────────────
# Must point to the public-facing backend URL (what the browser uses)
NEXT_PUBLIC_API_URL=https://your-api.com/api
NODE_ENV=production
