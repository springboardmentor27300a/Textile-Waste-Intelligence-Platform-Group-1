# ────────────────────────────────────────────────────────────────────────────
# Textile Waste Intelligence Platform — Backend Environment Variables
# Copy this file to .env and fill in the values for your environment.
# ────────────────────────────────────────────────────────────────────────────

# ── Database ──────────────────────────────────────────────────────────────────
# SQLite (default for development):
DATABASE_URL=sqlite+aiosqlite:///./textile_waste.db

# PostgreSQL (recommended for production):
# DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/textile_waste_db

# ── Security ──────────────────────────────────────────────────────────────────
# IMPORTANT: Change this to a long random string in production!
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=your-super-secret-key-change-in-production-use-64-chars

ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440   # 24 hours (use 60 for production)

# ── CORS ──────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed frontend origins (JSON array format)
BACKEND_CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]

# For production add your actual domain:
# BACKEND_CORS_ORIGINS=["https://your-app.com","https://www.your-app.com"]

# ── Application ───────────────────────────────────────────────────────────────
ENVIRONMENT=development        # development | production | staging
LOG_LEVEL=INFO                 # DEBUG | INFO | WARNING | ERROR
MAX_UPLOAD_SIZE_MB=10          # Maximum image upload size in MB

# ── Production Only ───────────────────────────────────────────────────────────
# ALLOWED_HOSTS=your-app.com,www.your-app.com
