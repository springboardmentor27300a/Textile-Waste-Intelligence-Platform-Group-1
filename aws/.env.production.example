# ==============================================================================
# Production Environment Variables for AWS Cloud Services
# ==============================================================================

# Application Environment
ENVIRONMENT=production
PORT=8000

# Database Configuration (PostgreSQL / AWS RDS)
DATABASE_URL=postgresql://textile_admin:production_secure_db_password_2026@postgres:5432/textile_waste_db
# For AWS RDS PostgreSQL, format:
# DATABASE_URL=postgresql://<DB_USER>:<DB_PASSWORD>@<RDS_ENDPOINT>.rds.amazonaws.com:5432/textile_waste_db

# Security & Authentication
JWT_SECRET_KEY=production-textile-intelligence-jwt-secret-key-2026-super-secure
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# AWS S3 Storage (Optional: For cloud asset archiving)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
AWS_S3_BUCKET_NAME=textile-waste-intelligence-assets

# CORS Origins (Allowed Frontend URLs in Production)
CORS_ORIGINS=http://localhost,http://localhost:5173,http://localhost:80
