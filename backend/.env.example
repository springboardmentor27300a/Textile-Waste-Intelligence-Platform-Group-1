# Database Connection URL (PostgreSQL for Production, SQLite for local dev)
# Production PostgreSQL Example:
DATABASE_URL=postgresql://textile_admin:production_secure_db_password_2026@localhost:5432/textile_waste_db
# Local SQLite Example:
# DATABASE_URL=sqlite:///./textile_waste.db

# JWT Secret Key for Authentication (Generate a secure random string in production)
JWT_SECRET_KEY=change-this-to-a-long-random-string-in-production

# Application Environment (production / development)
ENVIRONMENT=production
PORT=8000
